ARG FEDORA_VERSION=45
FROM quay.io/fedora/fedora-bootc:${FEDORA_VERSION}

ARG PAYLOAD_IMAGE=ghcr.io/rafayuri/fedora_rynux:latest

# 1. Instala os pacotes exigidos pelo contrato do bootc-generic-iso + utilitários do TUI
RUN dnf install -y --setopt=tsflags=nodocs \
    shim-x64 \
    grub2-efi-x64 \
    grub2-efi-x64-cdboot \
    grub2-pc-modules \
    grub2-tools \
    grub2-tools-minimal \
    grub2-common \
    dracut-live \
    squashfs-tools \
    xorriso \
    isomd5sum \
    dosfstools \
    e2fsprogs \
    btrfs-progs \
    util-linux \
    parted \
    gdisk \
    kbd \
    dialog \
    podman \
    skopeo \
    python3 && \
    dnf clean all

# 2. Cumpre o contrato EFI e GRUB2 do image-builder (/boot/efi/EFI/fedora/{shimx64,mmx64,gcdx64}.efi)
RUN set -eux; \
    mkdir -p /boot/efi /usr/share/grub2 && \
    cp -ra /usr/lib/efi/*/*/EFI /boot/efi && \
    [ -e /usr/share/grub2/unicode.pf2 ] || ln -sf /usr/share/grub/unicode.pf2 /usr/share/grub2/unicode.pf2 && \
    test -f /boot/efi/EFI/fedora/shimx64.efi && \
    test -f /boot/efi/EFI/fedora/mmx64.efi && \
    test -f /boot/efi/EFI/fedora/gcdx64.efi && \
    test -d /usr/lib/grub/i386-pc

# 3. Configura o console para ABNT2 e instala o TUI no tty1
RUN echo "KEYMAP=br-abnt2" > /etc/vconsole.conf

COPY iso/rynux-installer.sh /usr/local/bin/rynux-installer
RUN sed -i "s|@@PAYLOAD_IMAGE@@|${PAYLOAD_IMAGE}|g" /usr/local/bin/rynux-installer && \
    chmod +x /usr/local/bin/rynux-installer

COPY iso/rynux-installer.service /etc/systemd/system/rynux-installer.service
RUN systemctl disable getty@tty1.service && \
    systemctl enable rynux-installer.service

# 4. Copia o iso.yaml para o caminho canônico do osbuild/image-builder
RUN mkdir -p /usr/lib/image-builder/bootc
COPY iso/iso.yaml /usr/lib/image-builder/bootc/iso.yaml

# 5. Evita montagem automática de discos locais no boot da ISO e gera o initramfs Live
RUN set -eux; \
    rm -f /usr/lib/systemd/system-generators/systemd-gpt-auto-generator && \
    mkdir -p "$(realpath /root)" && \
    KVER="$(ls -1 /usr/lib/modules | head -n 1)" && \
    DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
        --add "dmsquash-live pollcdrom overlayfs" \
        --omit "ostree bootc" \
        "/usr/lib/modules/${KVER}/initramfs.img" "${KVER}" && \
    test -f "/usr/lib/modules/${KVER}/vmlinuz" && \
    test -f "/usr/lib/modules/${KVER}/initramfs.img"
