ARG BASE_IMAGE=ghcr.io/rafayuri/fedora_rynux:latest
FROM ${BASE_IMAGE}

# 1. Instala utilitários de mídia, módulos live do dracut e binários de boot
RUN dnf install -y --setopt=tsflags=nodocs \
    shim-x64 \
    grub2-efi-x64-cdboot \
    grub2-pc-modules \
    grub2-tools \
    xorriso \
    squashfs-tools \
    isomd5sum \
    dracut-live && \
    dnf clean all

# 2. Regenera o initramfs do container adicionando suporte explícito a Live ISO (dmsquash-live)
RUN set -eux; \
    KVER="$(ls -1 /usr/lib/modules | head -n 1)"; \
    echo "Regenerando initramfs para o kernel: ${KVER}"; \
    dracut -v --force --no-hostonly --add "dmsquash-live pollcdrom" "/usr/lib/modules/${KVER}/initramfs.img" "${KVER}"; \
    test -f "/usr/lib/modules/${KVER}/initramfs.img"

# 3. Configura os executáveis EFI esperados pelo osbuild (sem sobrescrever gcdx64)
RUN set -eux; \
    mkdir -p /boot/efi/EFI/fedora; \
    GCD_BIN="$(find /usr -name "gcdx64.efi" 2>/dev/null | head -n 1)"; \
    SHIM_BIN="$(find /usr/lib/efi/shim -name "shimx64.efi" 2>/dev/null | head -n 1 || find /usr -name "shimx64.efi" | head -n 1)"; \
    MM_BIN="$(find /usr/lib/efi/shim -name "mmx64.efi" 2>/dev/null | head -n 1 || find /usr -name "mmx64.efi" | head -n 1)"; \
    cp "${GCD_BIN}" /boot/efi/EFI/fedora/gcdx64.efi; \
    cp "${SHIM_BIN}" /boot/efi/EFI/fedora/shimx64.efi; \
    cp "${MM_BIN}" /boot/efi/EFI/fedora/mmx64.efi; \
    test -f /boot/efi/EFI/fedora/gcdx64.efi; \
    test -f /boot/efi/EFI/fedora/shimx64.efi

# 4. Injeta a configuração do GRUB da ISO
COPY iso.yaml /usr/lib/bootc-image-builder/iso.yaml